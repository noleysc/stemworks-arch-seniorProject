generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String     @id @default(cuid())
  key       String     @unique
  name      String
  planTier  String     @default("internal")
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  ventures  Venture[]
  properties Property[]
  todos     DashboardTodo[]
}

model Venture {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  key         String
  name        String
  type        String
  prefixCode  String
  colorToken  String
  statusLabel String
  createdAt   DateTime @default(now())

  materials Material[]
  skus      Sku[]
  customers Customer[]
  orders    Order[]
  events    ExperienceEvent[]
  crmContacts BusinessCrmContact[]
  appointments ServiceAppointment[]

  @@unique([tenantId, key])
  @@unique([tenantId, prefixCode])
}

model Property {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  key      String         @unique
  name     String
  address  String
  timezone String
  keys     Int
  sources  RentalSource[]
  bookings Booking[]
}

model RentalSource {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  key         String
  label       String
  importShape String
  createdAt   DateTime @default(now())

  @@unique([propertyId, key])
}

model Booking {
  id               String   @id @default(cuid())
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id])
  kind             String
  channel          String
  guestName        String
  partySize        Int
  arrivalDate      String
  departureDate    String?
  reservationTime  String?
  outlet           String?
  roomType         String?
  confirmationCode String?
  status           String
  amountCents      Int?
  notes            String?
  source           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([propertyId, kind, arrivalDate])
  @@index([propertyId, channel, confirmationCode])
}

model Material {
  id            String   @id @default(cuid())
  ventureId     String
  venture       Venture  @relation(fields: [ventureId], references: [id])
  name          String
  category      String
  unit          String
  supplier      String?
  supplierSku   String?
  reorderPoint  Int      @default(0)
  leadTimeDays  Int      @default(7)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  purchases     MaterialPurchase[]
  level         InventoryLevel?
  movements     InventoryMovement[]

  @@index([ventureId, name])
}

model MaterialPurchase {
  id                 String   @id @default(cuid())
  materialId         String
  material           Material @relation(fields: [materialId], references: [id])
  receivedOn         String
  quantityReceived   Int
  quantityRemaining  Int
  totalCostCents     Int
  costPerUnitCents   Int
  supplierOrderRef   String?
  createdAt          DateTime @default(now())
}

model InventoryLevel {
  materialId     String   @id
  material       Material @relation(fields: [materialId], references: [id])
  quantityOnHand Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model InventoryMovement {
  id           String   @id @default(cuid())
  materialId   String
  material     Material @relation(fields: [materialId], references: [id])
  kind         String
  quantity     Int
  referenceId  String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([materialId, createdAt])
}

model Sku {
  id               String   @id @default(cuid())
  ventureId        String
  venture          Venture  @relation(fields: [ventureId], references: [id])
  code             String
  name             String
  retailCents      Int
  wholesaleCents   Int
  eventCents       Int
  unitsOnHand      Int      @default(0)
  unitsAllocated   Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lineItems        OrderLineItem[]

  @@unique([ventureId, code])
}

model Customer {
  id        String   @id @default(cuid())
  ventureId String
  venture   Venture  @relation(fields: [ventureId], references: [id])
  name      String
  email     String?
  kind      String
  createdAt DateTime @default(now())
  orders    Order[]

  @@index([ventureId, name])
}

model Order {
  id             String   @id @default(cuid())
  ventureId      String
  venture        Venture  @relation(fields: [ventureId], references: [id])
  code           String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerName   String
  channel        String
  status         String
  netAmountCents Int
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lineItems      OrderLineItem[]

  @@unique([ventureId, code])
  @@index([ventureId, status])
}

model OrderLineItem {
  id              String @id @default(cuid())
  orderId         String
  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId           String
  sku             Sku    @relation(fields: [skuId], references: [id])
  quantity        Int
  unitPriceCents  Int
  lineTotalCents  Int
}

/// Experiences + CRM (PRD pilot). Private CRM and per-vendor consent live here.
model GuestProfile {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  phone        String?
  networkOptIn Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  registrations EventRegistration[]
  consents     VendorConsent[]
  crmContacts  BusinessCrmContact[]
  audits       ConsentAudit[]
  appointments ServiceAppointment[]
}

/// Individual spa/service booking (not a ticketed invite).
model ServiceAppointment {
  id               String        @id @default(cuid())
  ventureId        String
  venture          Venture       @relation(fields: [ventureId], references: [id])
  guestId          String?
  guest            GuestProfile? @relation(fields: [guestId], references: [id])
  clientName       String
  clientEmail      String?
  clientPhone      String?
  serviceKey       String
  serviceTitle     String
  durationMinutes  Int?
  priceCents       Int           @default(0)
  appointmentOn    String
  startsAtLabel    String
  status           String        @default("booked")
  notes            String?
  confirmationCode String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([ventureId, appointmentOn])
  @@index([appointmentOn, status])
}

model DashboardTodo {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  title     String
  done      Boolean  @default(false)
  dueOn     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, done, sortOrder])
}

model ExperienceEvent {
  id               String   @id @default(cuid())
  ventureId        String
  venture          Venture  @relation(fields: [ventureId], references: [id])
  slug             String   @unique
  title            String
  summary          String
  location         String
  startsOn         String
  endsOn           String?
  startsAtLabel    String?
  capacity         Int
  ticketPriceCents Int      @default(0)
  status           String   @default("draft")
  disclosureText   String
  hostDisplayName  String   @default("Jade Experiences")
  coverTone        String   @default("slate")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  vendors          EventVendor[]
  tiers            TicketTier[]
  itineraryItems   EventItineraryItem[]
  registrations    EventRegistration[]

  @@index([ventureId, startsOn])
}

model EventItineraryItem {
  id              String          @id @default(cuid())
  eventId         String
  event           ExperienceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startsAtLabel   String
  title           String
  detail          String?
  placeLabel      String?
  emoji           String?
  serviceKey      String?
  durationMinutes Int?
  menuPriceCents  Int?
  category        String?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([eventId, sortOrder])
}

model TicketTier {
  id               String          @id @default(cuid())
  eventId          String
  event            ExperienceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  key              String
  label            String
  description      String
  priceCents       Int
  quantityAvailable Int
  sortOrder        Int             @default(0)
  isActive         Boolean         @default(true)
  registrations    EventRegistration[]

  @@unique([eventId, key])
}

model EventVendor {
  id           String          @id @default(cuid())
  eventId      String
  event        ExperienceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  businessKey  String
  displayName  String
  roleLabel    String
  sortOrder    Int             @default(0)
  consents     VendorConsent[]
  crmContacts  BusinessCrmContact[]

  @@unique([eventId, businessKey])
}

model EventRegistration {
  id               String          @id @default(cuid())
  eventId          String
  event            ExperienceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId          String
  guest            GuestProfile    @relation(fields: [guestId], references: [id])
  tierId           String?
  tier             TicketTier?     @relation(fields: [tierId], references: [id])
  status           String          @default("registered")
  partySize        Int             @default(1)
  ticketQuantity   Int             @default(1)
  amountPaidCents  Int             @default(0)
  amountDueCents   Int             @default(0)
  confirmationCode String?
  paymentRef       String?
  paymentStatus    String          @default("unpaid")
  paymentBrand     String?
  paymentLast4     String?
  paidAt           DateTime?
  showOnGuestWall  Boolean         @default(true)
  wallName         String?
  guestNote        String?
  notes            String?
  checkedInAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  consents         VendorConsent[]

  @@unique([eventId, guestId])
  @@unique([confirmationCode])
  @@index([eventId, status])
}

model VendorConsent {
  id             String            @id @default(cuid())
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         EventVendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  guestId        String
  guest          GuestProfile      @relation(fields: [guestId], references: [id])
  granted        Boolean
  channelScope   String            @default("email")
  source         String
  createdAt      DateTime          @default(now())
  revokedAt      DateTime?

  @@unique([registrationId, vendorId])
  @@index([vendorId, granted])
}

model BusinessCrmContact {
  id              String       @id @default(cuid())
  ventureId       String
  venture         Venture      @relation(fields: [ventureId], references: [id])
  businessKey     String
  guestId         String
  guest           GuestProfile @relation(fields: [guestId], references: [id])
  sourceEventId   String?
  sourceVendorId  String?
  sourceVendor    EventVendor? @relation(fields: [sourceVendorId], references: [id])
  fullName        String
  email           String?
  phone           String?
  status          String       @default("active")
  followUpStatus  String       @default("none")
  lastInteraction String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([ventureId, businessKey, guestId])
  @@index([ventureId, businessKey, status])
}

model ConsentAudit {
  id           String       @id @default(cuid())
  guestId      String
  guest        GuestProfile @relation(fields: [guestId], references: [id])
  businessKey  String
  action       String
  channelScope String
  source       String
  disclosure   String?
  createdAt    DateTime     @default(now())

  @@index([guestId, createdAt])
  @@index([businessKey, createdAt])
}
