generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Property {
  id       String         @id @default(cuid())
  key      String         @unique
  name     String
  address  String
  timezone String
  keys     Int
  sources  RentalSource[]
  bookings Booking[]
}

model RentalSource {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  key         String
  label       String
  importShape String
  createdAt   DateTime @default(now())

  @@unique([propertyId, key])
}

model Booking {
  id               String   @id @default(cuid())
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id])
  kind             String
  channel          String
  guestName        String
  partySize        Int
  arrivalDate      String
  departureDate    String?
  reservationTime  String?
  outlet           String?
  roomType         String?
  confirmationCode String?
  status           String
  amountCents      Int?
  notes            String?
  source           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([propertyId, kind, arrivalDate])
  @@index([propertyId, channel, confirmationCode])
}
